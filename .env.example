# Chainlink Data Streams — Candlestick API (server-only; never NEXT_PUBLIC_*)
# Testnet: https://priceapi.testnet-dataengine.chain.link
# Mainnet: https://priceapi.dataengine.chain.link

CHAINLINK_BASE_URL=https://priceapi.dataengine.chain.link
# Candlestick JWT (`/api/v1/authorize`: login + password)
CHAINLINK_USER_ID=your_user_id
CHAINLINK_API_KEY=your_api_key
# Data Streams SDK only — `api_key` must be the Data Engine **client UUID** (Authorization); the other value is the HMAC secret.
# If the WS handshake returns HTTP 400, check you did not swap key and secret (the app auto-swaps when key is not a UUID but secret is).
CHAINLINK_STREAM_API_KEY=your_stream_client_uuid
CHAINLINK_STREAM_API_SECRET=your_stream_hmac_secret
